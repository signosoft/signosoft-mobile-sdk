# Build products and resolver state. These pin absolute paths from whichever
# machine produced them, so a committed copy breaks every other consumer.
.dart_tool/
build/
.build/
.swiftpm/
Pods/
Package.resolved
pubspec.lock
**/ios/Flutter/ephemeral/
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
.flutter-plugins-dependencies
.gradle/
.cxx/
local.properties

# The example apps' build trees are symlinks out to ~/.flutter-build when the
# checkout sits under an iCloud-synced directory — codesign rejects every
# framework built below one. `build/` above has a trailing slash and does not
# match a symlink, so name them.
/signosoft_signer/example/build
/examples/medicly/build

# Gradle and Kotlin build state. Machine-local caches, rewritten on every
# build, and they pin absolute paths the same way `build/` above does. The
# `android/` directory at the repo root holds nothing but these leftovers — the
# Kotlin library itself lives unmerged on feature/android-sdk.
.gradle/
.kotlin/

# Regenerated by Flutter in the examples' Android folders on `flutter pub get`
# and on build. `local.properties` pins this machine's SDK paths; the wrapper
# and the plugin registrant are written from the Flutter tool's own copies.
# Android is not a supported platform for this SDK — these exist only because
# `flutter create` laid the folders down.
**/android/local.properties
**/android/gradlew
**/android/gradlew.bat
**/android/gradle/wrapper/gradle-wrapper.jar
**/android/**/GeneratedPluginRegistrant.java

# Editor and OS noise.
.idea/
*.iml
xcuserdata/
.DS_Store

# local dev helper secrets
tools/.mint-bioid.env
tools/.last-bioid
